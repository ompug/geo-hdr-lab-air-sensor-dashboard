# Paths used by the Fedora systemd installation.
AIR_SENSORS_CONFIG=/etc/air-sensors/sensors.yaml
AIR_SENSORS_DATA_DIR=/var/lib/air-sensors
AIR_SENSORS_DATABASE=/var/lib/air-sensors/air-sensors.db

# Web service binding. Keep the sensors themselves on the internal network.
AIR_SENSORS_HOST=0.0.0.0
AIR_SENSORS_PORT=8000

# A sensor is offline when no valid telemetry arrives within this period.
AIR_SENSORS_STALE_AFTER=90

# SSE is continuous; REST is used for recovery and this consistency interval.
AIR_SENSORS_CONSISTENCY_POLL=60
AIR_SENSORS_HTTP_TIMEOUT=10
AIR_SENSORS_RECONNECT_MAX=60

# Store at most one snapshot per sensor in this interval.
AIR_SENSORS_READING_INTERVAL=30

# Set to 0 to disable automatic historical cleanup.
AIR_SENSORS_RETENTION_DAYS=365
AIR_SENSORS_COLLECTOR_ENABLED=true
